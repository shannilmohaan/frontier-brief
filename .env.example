# ============================================================
# Frontier Brief — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ---- DATABASE (Neon PostgreSQL) ----------------------------
# Source: Neon dashboard → your project → Connection Details → Pooled connection
# Add ?sslmode=require at the end
DATABASE_URL=postgresql+asyncpg://user:password@host/frontier_brief?sslmode=require

# ---- LLM (Anthropic) ---------------------------------------
# Source: console.anthropic.com → API Keys
# IMPORTANT: Set a $5/month spend limit in the Anthropic Console BEFORE using this key!
ANTHROPIC_API_KEY=

# ---- DATA SOURCES ------------------------------------------
# YouTube Data API v3
# Source: console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# Tavily web search (articles + social signal proxy for X/LinkedIn trending content)
# Source: app.tavily.com → free tier (1000 searches/month)
# Optional — WebArticlesFetcher skips gracefully when absent, but article coverage is reduced
TAVILY_API_KEY=

# Google News RSS, Reddit, podcasts: no API keys required

# ---- SECURITY ----------------------------------------------
# Protects POST /api/refresh — the only endpoint that triggers LLM calls
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this in Railway AND copy the same value to Vercel as NEXT_PUBLIC_REFRESH_KEY
REFRESH_KEY=

# ---- SCHEDULER ---------------------------------------------
REFRESH_INTERVAL_HOURS=48
MAX_ITEMS_PER_DOMAIN=10

# ---- FRONTEND (set these in Vercel dashboard) --------------
# NEXT_PUBLIC_API_URL: your Railway backend public URL
#   e.g. https://frontier-brief-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-railway-service.up.railway.app
# Same value as REFRESH_KEY above
NEXT_PUBLIC_REFRESH_KEY=
